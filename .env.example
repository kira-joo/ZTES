# Copy to .env. Never commit .env.

# MongoDB REPLICA SET (docker compose up -d). Transactions require it.
MONGODB_URI=mongodb://localhost:27021/?replicaSet=rs0&directConnection=true
MONGODB_DB=ztes

# Public origin, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
SITE_URL=http://localhost:3030

# Admin — one admin, no user collection.
# At least 12 characters.
ADMIN_PASSWORD=
# Bump to sign every admin session out.
ADMIN_TOKEN_VERSION=1
# At least 32 characters: openssl rand -base64 48
JWT_SECRET=
# Optional durations (defaults shown).
ADMIN_ACCESS_TOKEN_TTL=15m
ADMIN_REFRESH_TOKEN_TTL=7d

# Cloudinary. Unset = uploads are off (announced once at boot); saves without images still work.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
